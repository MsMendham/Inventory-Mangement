<UserControl x:Class="Inventory_management_v1.addUsers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inventory_management_v1"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="600" 
             Background="#a4dbc4"
             FontSize="20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="2" 
                   Grid.Column="2"
                   Text="Please enter new users details"
                   FontSize="24"
                   Grid.ColumnSpan="3"  
                   Margin="0,10,0,10"
                   x:Name="topText"
                   
                   />
        <TextBlock Grid.Column="2"
                   Grid.Row="3"
                   Text="Username:" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="3"
                 Width="150"
                 Height="auto" Margin="5,0,10,10"
                 x:Name="UName"
                 />

        <TextBlock Grid.Column="2"
                   Grid.Row="4"
                   Text="Password:" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="4"
                 Width="150"
                 Height="auto" Margin="5,0,10,10"
                 x:Name="PWord"
                 />
        <TextBlock Grid.Column="2"
                   Grid.Row="5"
                   Text="Permissions:" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="5"
                 Width="150"
                 Height="auto" Margin="5,0,10,10"
                 x:Name="Perms"
                 />
        <TextBlock Grid.Column="2"
                   Grid.Row="6"
                   Text="Your Password:" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="6"
                 Width="150"
                 Height="auto" Margin="5,0,10,10"
                 x:Name="YourPass"
                 />
        <Button x:Name="Enter"
                Grid.Column="5"
                Grid.Row="6"
                Width="auto"
                Height="auto"
                Content="Enter"
                Style="{DynamicResource White Button}" Click="EnterClicked"
                />
                

    </Grid>
</UserControl>
