<Window x:Class="Inventory_management_v1.LoginMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventory_management_v1"
        mc:Ignorable="d" 
        FontSize="18"
        Title="LoginMenu" 
        Height="250" 
        Width="425" 
        ResizeMode="CanMinimize"
        Background="#a4dbc4"
        >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>

            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <TextBlock 
            Grid.Column="2" 
            Grid.Row="2" 
            FontSize="24" 
            Text="Enter Username and password" 
            Grid.ColumnSpan="4"
            Margin="0,0,0,10"
         />

        <TextBlock 
            Grid.Column="3"
            Grid.Row="3"
            Text="Username:" 
            HorizontalAlignment="Right"
            Margin="0,0,5,5"/>

        <TextBox 
            x:Name="Username"
            Grid.Row="3"
            Grid.Column="4" 
            Width="150"
            Margin="5,0,0,5" 
            HorizontalAlignment="Left"
            BorderBrush="Black"
            />
        
        <TextBlock 
            Grid.Column="3"
            Grid.Row="4"
            Text="Password:" 
            HorizontalAlignment="Right"
            Margin="0,5,5,0"/>
        
        <TextBox 
            x:Name="Password"
            Grid.Row="4"
            Grid.Column="4" 
            Width="150"
            Margin="5,5,0,0" 
            HorizontalAlignment="Left"
            BorderBrush="Black"
            />
        
        <Button x:Name="Submit" 
                Content="Login" 
                Grid.Column="4" 
                Grid.Row="5" 
                Margin="82,5,20,5" 
                Click="LoginButton" 
                Background="White"
                />

        <TextBlock x:Name="Alertbox" 
                   Text=""
                   Grid.Column="3"
                   Grid.Row="6"
                   Grid.ColumnSpan="3"
                   FontSize="14"
                   Foreground="Red"
                   HorizontalAlignment="Center"
                   />

    </Grid>
</Window>
