<UserControl x:Class="Inventory_management_v1.EditBatches"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Inventory_management_v1"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="600"
             Background="#a4dbc4"
             FontSize="20">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="2" 
                   Grid.Column="2"
                   Text="Enter batch to be changed and new data"
                   FontSize="24"
                   Grid.ColumnSpan="3"  
                   Margin="0,10,0,10"
                   
                   />
        <TextBlock Grid.Column="2"
                   Grid.Row="3"
                   Text="Batch Number to Edit:" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="3"
                 Width="150"
                 Height="auto" Margin="0,0,10,10"
                 x:Name="BatchID"
                 />

        <TextBlock Grid.Column="2"
                   Grid.Row="4"
                   Text="New Item:" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="4"
                 Width="150"
                 Height="auto" Margin="0,0,10,10"
                 x:Name="NewItem"
                 />
        <TextBlock Grid.Column="2"
                   Grid.Row="5"
                   Text="New Quantity" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="5"
                 Width="150"
                 Height="auto" Margin="0,0,10,10"
                 x:Name="NewQuant"
                 />
        <TextBlock Grid.Column="2"
                   Grid.Row="6"
                   Text="New Expiry Date" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="6"
                 Width="150"
                 Height="auto" Margin="0,0,10,10"
                 x:Name="NewDate"
                 />
        

        <TextBlock Grid.Column="2"
                   Grid.Row="7"
                   Text="Your Password:" 
                   HorizontalAlignment="Right"
                   
                   
                   />
        <TextBox Grid.Column="3"
                 Grid.Row="7"
                 Width="150"
                 Height="auto" Margin="0,0,10,10"
                 x:Name="YourPass"
                 />

        <Button x:Name="Enter"
                Grid.Column="4"
                Grid.ColumnSpan="2"
                Grid.Row="6"
                Width="auto"
                Height="auto"
                Content="Enter"
                Style="{DynamicResource White Button}"
                />
    </Grid>
</UserControl>
