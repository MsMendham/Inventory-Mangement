<Window x:Class="Inventory_management_v1.InventoryMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Inventory_management_v1"
        mc:Ignorable="d"
        Title="InventoryMenu"
        Height="1080" 
        Width="1920"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#a4dbc4">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="2"
            Grid.Column="3"
            Text="Inventory"
            FontSize="100"
            Grid.ColumnSpan="2"
            TextAlignment="Center"
            />
        <TextBlock
            Name="Username"
            Grid.Row="1"
            Grid.Column="1"
            Text="TestUsername"
            FontSize="40"
            Grid.ColumnSpan="2"
            />
        <Button
            Name="Batches"
            Grid.Column="3"
            Grid.Row="4"
            Width="500"
            Height="100"
            Content="Batches"
            FontSize="60"
            Style="{DynamicResource FancyButton}"
            />
        <Button
            Name="Items"
            Grid.Column="4"
            Grid.Row="4"
            Width="500"
            Height="100"
            Content="Items"
            FontSize="60"
            Style="{DynamicResource FancyButton}"
            />
        <ListBox
            Grid.Row="5"
            Grid.Column="3"
            Grid.ColumnSpan="2"
            Name="Box"
            FontSize="40"
            Height="450"
            
            />
        <!--welp this list box needs to be finished and funcs added before other funtionality i thiunk-->


    </Grid>
</Window>